# Target Backend configuration. setup.sh synchronizes this file to backend/.env.

APP_NAME=Clawith
DEBUG=false
DATABASE_URL=postgresql+asyncpg://clawith_target:clawith_target@localhost:5432/clawith_target?ssl=disable
CONTROL_DATABASE_POOL_SIZE=20
EXECUTION_DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=0
